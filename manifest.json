{
  "manifest_version": 3,
  "name": "QA Annotator",
  "version": "0.1.0",
  "description": "Annotate any page during manual QA and export a report for a coding agent.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_title": "QA Annotator" },
  "commands": {
    "toggle-qa-mode": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description": "Toggle QA annotation mode"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "manifest.json",
        "src/content/*.js",
        "src/lib/*.js",
        "src/*.css"
      ],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["src/frame/card.html", "src/frame/list.html"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ]
}
